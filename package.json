{
  "name": "dsh-infinite-context",
  "version": "0.9.9",
  "description": "DSH 上下文治理插件：可逆压缩、分层记忆，折叠的时机与幅度随实际使用学习，每份摘要分段提炼并经原文核对。/ Context governance for DeepSeek Harness: reversible compaction, layered memory, a fold rhythm learned from use, and every summary built in segments and checked against the original.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chocobo77/dsh-infinite-context.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context-window",
    "context-management",
    "compaction",
    "rag",
    "llm"
  ],
  "files": [
    "dist",
    "bundle.patch.yml",
    "cordis.yml"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory-context": {
      "types": "./dist/memory-context.d.ts",
      "default": "./dist/memory-context.js"
    },
    "./memory-compaction": {
      "types": "./dist/memory-compaction.d.ts",
      "default": "./dist/memory-compaction.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run verify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-compaction": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
