{
  "name": "dsh-infinite-context",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: multi-tier memory management, semantic retrieval, structured memory, and model-context awareness for infinite context.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chocobo77/dsh-infinite-context.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context-window",
    "compaction",
    "rag"
  ],
  "files": [
    "src",
    "bundle.patch.yml",
    "cordis.yml",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./memory-context": "./src/memory-context.ts",
    "./memory-compaction": "./src/memory-compaction.ts",
    "./core": "./src/core.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-agent": ">=0.1.1-0 <0.2.0-0",
    "@deepseek-ai/dsh-compaction": ">=0.1.1-0 <0.2.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.1-0 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-0 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.1-0 <0.2.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.1-0 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-0 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
